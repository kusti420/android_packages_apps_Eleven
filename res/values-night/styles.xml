<?xml version="1.0" encoding="utf-8"?>
<!-- IchthysOS: dark neutral surfaces with muted accent for interactive elements.
     Accent color only on small UI controls (progress bar, play button, switches);
     all container/surface colors stay neutral to avoid the wallpaper accent
     bleeding across the entire UI. -->
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <style name="Eleven.Theme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/system_neutral1_900</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">false</item>
        <item name="android:windowAllowReturnTransitionOverlap">false</item>
        <item name="preferenceTheme">@style/AppPreferenceThemeOverlay</item>

        <!-- Surfaces: all neutral dark -->
        <item name="android:colorBackground">@android:color/system_neutral1_900</item>
        <item name="colorSurface">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceContainer">@android:color/system_neutral1_800</item>
        <item name="colorSurfaceContainerHigh">@android:color/system_neutral1_700</item>
        <item name="colorSurfaceContainerHighest">@android:color/system_neutral1_600</item>
        <item name="colorSurfaceContainerLow">@android:color/system_neutral1_900</item>
        <item name="colorSurfaceContainerLowest">@android:color/system_neutral1_900</item>
        <item name="colorOnSurface">@android:color/system_neutral1_100</item>
        <item name="colorOnSurfaceVariant">@android:color/system_neutral2_200</item>

        <!-- Primary: muted accent for buttons/progress/switches only -->
        <item name="colorPrimary">@android:color/system_accent1_200</item>
        <item name="colorOnPrimary">@android:color/system_neutral1_900</item>

        <!-- Primary containers: NEUTRAL — this is what bleeds pink on the
             now-playing bar (AlbumScrimImage) and BottomNavigationView indicator -->
        <item name="colorPrimaryContainer">@android:color/system_neutral1_800</item>
        <item name="colorOnPrimaryContainer">@android:color/system_neutral1_100</item>

        <!-- Secondary containers: neutral -->
        <item name="colorSecondaryContainer">@android:color/system_neutral1_800</item>
        <item name="colorOnSecondaryContainer">@android:color/system_neutral1_100</item>

        <!-- Tertiary containers: neutral -->
        <item name="colorTertiaryContainer">@android:color/system_neutral1_800</item>
        <item name="colorOnTertiaryContainer">@android:color/system_neutral1_100</item>

            <!-- Inverse surfaces -->
        <item name="colorSurfaceInverse">@android:color/system_neutral1_100</item>
        <item name="colorOnSurfaceInverse">@android:color/system_neutral1_800</item>
    </style>


</resources>
